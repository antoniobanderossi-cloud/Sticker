generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  telegramId BigInt  @unique
  username  String?
  firstName String?
  lastName  String?
  tokens    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stickerPacks StickerPack[]
  transactions Transaction[]

  @@index([telegramId])
}

model StickerPack {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  telegramName String?
  title        String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // 'purchase' или 'generation'
  amount    Int      // количество токенов
  stars     Int?     // количество Telegram Stars (для покупок)
  createdAt DateTime @default(now())

  @@index([userId])
}
